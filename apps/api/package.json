{
  "name": "superwhite-api",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "ts-node --transpile-only -r dotenv/config scripts/db-migrate.ts",
    "db:import": "ts-node --transpile-only -r dotenv/config scripts/import-sqlite.ts",
    "create-super-admin": "ts-node --transpile-only -r dotenv/config scripts/create-super-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "rimraf": "^6.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.9"
  }
}
