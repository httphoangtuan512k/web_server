# Neon Postgres (URL pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Vercel Blob store (private)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# Chuỗi ngẫu nhiên >= 32 ký tự để ký cookie đăng nhập (openssl rand -hex 32)
SESSION_SECRET=
# Vercel tự gửi "Authorization: Bearer <CRON_SECRET>" khi gọi cron
CRON_SECRET=
# Chỉ dùng khi chạy local
PORT=4000
