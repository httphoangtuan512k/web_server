# Sao chép thành .env.local khi chạy trên máy; trên Vercel khai báo trong Settings → Environment Variables.

# Neon Postgres (URL pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Vercel Blob store (private) – ảnh, tài liệu Excel, bản sao lưu
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# Chuỗi ngẫu nhiên >= 32 ký tự để ký cookie đăng nhập (openssl rand -hex 32)
SESSION_SECRET=
# Vercel Cron gửi "Authorization: Bearer <CRON_SECRET>" khi gọi /api/cron/daily-backup
CRON_SECRET=
